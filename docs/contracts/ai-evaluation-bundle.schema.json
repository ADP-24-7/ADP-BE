{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adp.local/contracts/ai-evaluation-bundle.schema.json",
  "title": "ADP AI Evaluation Bundle",
  "type": "object",
  "required": ["manifest", "execution_config", "case_results", "runtime_metrics", "trace_index"],
  "properties": {
    "manifest": { "$ref": "#/$defs/manifest" },
    "execution_config": { "$ref": "#/$defs/execution_config" },
    "case_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/case_result" }
    },
    "runtime_metrics": {
      "type": "array",
      "items": { "$ref": "#/$defs/runtime_metric" }
    },
    "trace_index": {
      "type": "array",
      "items": { "$ref": "#/$defs/trace_entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": ["string", "null"],
      "pattern": "^(sha256:)?[0-9a-f]{64}$"
    },
    "manifest": {
      "type": "object",
      "required": [
        "schema_version", "content_digest", "evaluation_run_id", "evaluation_run_version",
        "execution_count", "case_count", "model_count", "evidence_from", "evidence_to"
      ],
      "properties": {
        "schema_version": { "const": "adp-ai-evaluation-bundle/v1" },
        "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "evaluation_run_id": { "type": "string" },
        "evaluation_run_version": { "type": "string" },
        "execution_count": { "type": "integer", "minimum": 1 },
        "case_count": { "type": "integer", "minimum": 1 },
        "model_count": { "type": "integer", "minimum": 1 },
        "evidence_from": { "type": "string", "format": "date-time" },
        "evidence_to": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "execution_config": {
      "type": "object",
      "required": [
        "evaluation_run_id", "evaluation_run_version", "evaluation_contract_digest",
        "dataset_id", "dataset_version", "dataset_digest", "policy_snapshot_digest", "models"
      ],
      "properties": {
        "evaluation_run_id": { "type": "string" },
        "evaluation_run_version": { "type": "string" },
        "evaluation_contract_digest": { "$ref": "#/$defs/digest" },
        "dataset_id": { "type": "string" },
        "dataset_version": { "type": "string" },
        "dataset_digest": { "$ref": "#/$defs/digest" },
        "policy_snapshot_digest": { "$ref": "#/$defs/digest" },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/model_config" }
        }
      },
      "additionalProperties": false
    },
    "model_config": {
      "type": "object",
      "required": [
        "profile_id", "profile_version", "profile_digest", "provider_model_id",
        "provider_model_version", "connection_profile_id", "max_tokens", "temperature",
        "sampling_profile_version", "destination_profile_digest"
      ],
      "properties": {
        "profile_id": { "type": "string" },
        "profile_version": { "type": "string" },
        "profile_digest": { "$ref": "#/$defs/digest" },
        "provider_model_id": { "type": "string" },
        "provider_model_version": { "type": "string" },
        "connection_profile_id": { "type": "string" },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "temperature": { "type": "number", "minimum": 0 },
        "sampling_profile_version": { "type": "string" },
        "destination_profile_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "case_result": {
      "type": "object",
      "required": ["execution_id", "eval_case_id", "model_profile_id", "runtime_status"],
      "properties": {
        "execution_id": { "type": "string" },
        "eval_case_id": { "type": "string" },
        "model_profile_id": { "type": "string" },
        "runtime_status": { "type": "string" },
        "final_action": { "type": ["string", "null"] },
        "response_guard_status": { "type": ["string", "null"] },
        "controlled_delivery_status": { "type": ["string", "null"] },
        "provider_status": { "type": ["string", "null"] },
        "error_category": { "type": ["string", "null"] },
        "evidence_status": { "type": ["string", "null"] },
        "expected_input_digest": { "$ref": "#/$defs/digest" },
        "actual_input_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "runtime_metric": {
      "type": "object",
      "required": ["execution_id", "eval_case_id", "model_profile_id"],
      "properties": {
        "execution_id": { "type": "string" },
        "eval_case_id": { "type": "string" },
        "model_profile_id": { "type": "string" },
        "measurement_type": { "type": ["string", "null"] },
        "full_response_latency_millis": { "type": ["integer", "null"], "minimum": 0 },
        "attempt_elapsed_millis": { "type": ["integer", "null"], "minimum": 0 },
        "initial_runtime_latency_millis": { "type": ["integer", "null"], "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "token_usage_status": { "type": ["string", "null"] },
        "provider_http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "provider_status": { "type": ["string", "null"] },
        "error_category": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "trace_entry": {
      "type": "object",
      "required": ["execution_id", "created_at", "updated_at"],
      "properties": {
        "execution_id": { "type": "string" },
        "decision_id": { "type": ["string", "null"] },
        "connector_execution_id": { "type": ["string", "null"] },
        "provider_request_digest": { "$ref": "#/$defs/digest" },
        "provider_response_digest": { "$ref": "#/$defs/digest" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
