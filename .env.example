SERVER_PORT=8080
ADP_BE_PORT=8080
ADP_FE_PORT=5173
ADP_DA_PORT=8010
ADP_DOCS_PORT=3000

POSTGRES_DB=adp
POSTGRES_USER=adp
POSTGRES_PASSWORD=adp
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/adp
SPRING_DATASOURCE_USERNAME=adp
SPRING_DATASOURCE_PASSWORD=adp

ADP_LOCAL_USER_AUTH_ENABLED=true
ADP_LOCAL_FIXTURES_ENABLED=true
ADP_MOCK_RUNTIME_ENABLED=true
ADP_AI_CONNECTOR_ENABLED=true
ADP_AI_CONNECTOR_BASE_URL=http://mock-ai:8090
ADP_AI_CONNECTOR_CONNECT_TIMEOUT=2s
ADP_AI_CONNECTOR_READ_TIMEOUT=60s
ADP_DATA_ACCESS_PREVIEW_ENABLED=true
ADP_CONTEXT_PREVIEW_ENABLED=true
ADP_REQUEST_FRESHNESS_ENABLED=false
ADP_ACCEPT_CALLER_TRACE_ID=true
ADP_EGRESS_ALLOW_PRIVATE_DESTINATIONS=true

VITE_APP_ENV=local
VITE_API_MODE=real
VITE_API_BASE_URL=http://adp-be:8080

NVIDIA_API_KEY=
ADP_NVIDIA_BASE_URL=https://integrate.api.nvidia.com
ADP_AI_E2E_CONFIRM_REAL_PROVIDER=

# NCP-5 BE Artifact ContentStore. Keep credentials only in the ignored .env.
ADP_DIGITAL_ASSET_ARTIFACT_STORE_TYPE=local
ADP_NCP_OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
NCLOUD_REGION=KR
ADP_NCP_ARTIFACT_BUCKET=adp-qa-data-artifacts
NCLOUD_ACCESS_KEY=
NCLOUD_SECRET_KEY=
ADP_NCP_OBJECT_STORAGE_CONNECT_TIMEOUT=5s
ADP_NCP_OBJECT_STORAGE_READ_TIMEOUT=30s
ADP_NCP_ARTIFACT_INGEST_CONFIRM=NO
